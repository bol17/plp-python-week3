# Initial scores list
scores = [72, 45, 90, 61, 38]

# Counters for passes, fails, and total score sum
passes = 0
fails = 0
total_score = 0

# Loop through each score to assign grades and calculate metrics
for score in scores:
    total_score += score
    
    if score >= 80:
        grade = "A"
    elif score >= 70:
        grade = "B"
    elif score >= 50:
        grade = "C"
    else:
        grade = "F"
        
    print(f"Score: {score} - Grade: {grade}")
    
    if score >= 50:
        passes += 1
    else:
        fails += 1

# Calculate average score
average = round(total_score / len(scores), 1)

# Summary output
print("-" * 20)
print(f"Passed: {passes}")
print(f"Failed: {fails}")
print(f"Average Score: {average}") 